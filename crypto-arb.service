[Unit]
Description=Cryptocurrency Statistical Arbitrage Autonomous Trading Engine & Dashboard
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Dynamic_Cointegration-Based_Statistical-_arbitrage
EnvironmentFile=/home/ubuntu/Dynamic_Cointegration-Based_Statistical-_arbitrage/.env
ExecStart=/home/ubuntu/Dynamic_Cointegration-Based_Statistical-_arbitrage/venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

